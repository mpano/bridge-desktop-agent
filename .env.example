OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Choose openai (remote) or ollama (local). Changes require restart.
LLM_PROVIDER=openai
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=qwen3:8b
LOCAL_LLM_TIMEOUT_SECONDS=120
# Remote tool-result policy: status_only, allowlist, or all.
# User messages still go to OpenAI in openai mode.
REMOTE_TOOL_RESULTS=allowlist
REMOTE_TOOL_RESULT_ALLOWLIST=["email_search","email_read_thread","calendar_events","calendar_free_time","slack_search","slack_read_channel"]
DEFAULT_BROWSER=Google Chrome
DEFAULT_EDITOR=Goland
DATABASE_PATH=./agent.db
LOG_LEVEL=INFO
# Required bearer token for API requests; choose a long random value.
API_TOKEN=

# Voice is opt-in. Local STT keeps microphone audio on this Mac.
VOICE_STT_PROVIDER=local
VOICE_LOCAL_WHISPER_MODEL=small
# Default offline loading only. Enable once to permit downloading a Whisper model.
VOICE_ALLOW_MODEL_DOWNLOAD=false
VOICE_OPENAI_STT_MODEL=gpt-transcribe
VOICE_LANGUAGE=en
# Maximum command duration, even when background noise prevents silence detection.
VOICE_RECORD_SECONDS=15
VOICE_AUTO_STOP=true
VOICE_SILENCE_SECONDS=1.0
VOICE_SPEECH_WAIT_SECONDS=5
VOICE_ACTIVITY_THRESHOLD=0.012
VOICE_START_SOUND=true
# Menu-bar only: Command+Shift+Space. Registers one key; does not monitor typing.
VOICE_SHORTCUT_ENABLED=true
VOICE_TTS_VOICE=
VOICE_TTS_RATE=
# Background microphone listening is disabled unless BOTH values below are true.
VOICE_BACKGROUND_ENABLED=false
VOICE_WAKE_WORD_ENABLED=false
# Optional override. If blank, Bridge uses:
# ~/Library/Application Support/Bridge/wakewords/hey_bridge.onnx
# Train for "hey bridge", then: bridge --install-wakeword /path/to/hey_bridge.onnx
VOICE_WAKE_WORD_MODEL_PATH=
VOICE_WAKE_WORD_THRESHOLD=0.5

# Dashboard sign-in. Google sign-in reuses GOOGLE_CLIENT_ID/SECRET below.
# "Sign in with GitHub": create a GitHub OAuth App (github.com/settings/developers) with
# callback URL http://localhost:8000/api/v1/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_SESSION_HOURS=12
AUTH_REMEMBER_DAYS=30

# Apple Shortcuts Bridge may run WITHOUT asking first (exact names). Others need approval.
SHORTCUTS_TRUSTED=[]

# Connected services (optional): pip install -e '.[integrations]'
# OAuth access/refresh tokens are stored ONLY in macOS Keychain.
INTEGRATIONS_ENABLED=false
INTEGRATIONS_CALLBACK_PORT=8000
# Step-by-step setup and example requests: docs/SERVICES.md
# Google OAuth Desktop client; enable Gmail API and Google Calendar API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Slack public-client app with PKCE enabled, USER scopes (no bot scopes).
# Redirect URL: http://localhost:8000/api/v1/connections/callback/slack
SLACK_CLIENT_ID=
# Spotify public-client PKCE flow (no client secret).
# Redirect URI: http://127.0.0.1:8000/api/v1/connections/callback/spotify
SPOTIFY_CLIENT_ID=
