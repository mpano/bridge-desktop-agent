OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Choose openai (remote) or ollama (local). Changes require restart.
LLM_PROVIDER=openai
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=qwen3:8b
LOCAL_LLM_TIMEOUT_SECONDS=120
# Remote tool-result policy: status_only, allowlist, or all.
# User messages still go to OpenAI in openai mode.
REMOTE_TOOL_RESULTS=status_only
REMOTE_TOOL_RESULT_ALLOWLIST=[]
DEFAULT_BROWSER=Google Chrome
DEFAULT_EDITOR=Visual Studio Code
DATABASE_PATH=./agent.db
LOG_LEVEL=INFO
# Required bearer token for API requests; choose a long random value.
API_TOKEN=

# Voice is opt-in. Local STT keeps microphone audio on this Mac.
VOICE_STT_PROVIDER=local
VOICE_LOCAL_WHISPER_MODEL=small
VOICE_OPENAI_STT_MODEL=gpt-transcribe
VOICE_LANGUAGE=en
VOICE_RECORD_SECONDS=6
VOICE_TTS_VOICE=
VOICE_TTS_RATE=
# Background microphone listening is disabled unless BOTH values below are true.
VOICE_BACKGROUND_ENABLED=false
VOICE_WAKE_WORD_ENABLED=false
# Path to an openWakeWord model file you choose and install locally.
VOICE_WAKE_WORD_MODEL_PATH=
VOICE_WAKE_WORD_THRESHOLD=0.5
